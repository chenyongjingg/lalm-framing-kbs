        <!-- ===================== Honest boundary band ===================== -->
        <mxCell id="bnd" value="Honest boundary (reported, not avoided): deployment frame n=3,863, 3.6% pos &#8594; ROC-AUC 0.9784 (5-frame mean 0.9455 &#177; 0.030); calibrated threshold 0.1203 &#8594; 75.9% benign FPR (n=162) vs 0.0% (ShieldGemma, WildGuard); adaptive decay up to 20.0 pp; G2 not passed &#8594; MSRF is presented as a discriminative, in-distribution scorer, not a deployment threshold detector" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=13;fillColor=#ffffff;strokeColor=#b05f58;dashed=1;fontFamily=Arial;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
