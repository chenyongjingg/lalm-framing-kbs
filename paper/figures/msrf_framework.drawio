<mxfile host="Electron" modified="2026-08-27T23:52:00.000Z" version="26.0.0">
  <diagram id="msrf-framework" name="MSRF Framework">
    <mxGraphModel dx="2000" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== Title ===================== -->
        <mxCell id="title" value="MSRF: Knowledge-Driven Multi-Source Fusion Framework" style="text;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;html=1;align=center;fontFamily=Arial;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1880" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== Input ===================== -->
        <mxCell id="in" value="&lt;b&gt;Response r&lt;/b&gt;&lt;br&gt;text &amp;amp; audio renderings&lt;br&gt;of the same query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#8a8a8a;fontFamily=Arial;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="230" height="220" as="geometry" />
        </mxCell>

        <!-- ===================== Four knowledge sources ===================== -->
        <mxCell id="src-label" value="Four mutually non-overlapping knowledge sources" style="text;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;html=1;align=left;fontFamily=Arial;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="360" y="88" width="420" height="24" as="geometry" />
        </mxCell>
        <mxCell id="int" value="&lt;b&gt;Intent (x_int)&lt;/b&gt;&lt;br&gt;LoRA harmful-intent classifier (E2B base)&lt;br&gt;[p, p&#178;, ln(1+len)]" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=13;fillColor=#e7e1f2;strokeColor=#8a74b8;fontFamily=Arial;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="330" height="84" as="geometry" />
        </mxCell>
        <mxCell id="nar" value="&lt;b&gt;Narrative (x_nar)&lt;/b&gt;&lt;br&gt;interpretable discourse-structure features&lt;br&gt;[length, n_sent, narr_density, story_words]" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=13;fillColor=#dbe7f5;strokeColor=#5f85b8;fontFamily=Arial;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="220" width="330" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ac" value="&lt;b&gt;Acoustic (x_ac)&lt;/b&gt;&lt;br&gt;prosodic features; mean-imp + mask&lt;br&gt;[f0, energy, dur, zcr, speech/pause]" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=13;fillColor=#fdeeda;strokeColor=#c9962f;fontFamily=Arial;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="320" width="330" height="84" as="geometry" />
        </mxCell>
        <mxCell id="unc" value="&lt;b&gt;Uncertainty (x_unc)&lt;/b&gt;&lt;br&gt;multi-scorer disagreement&lt;br&gt;2 x min(p, 1-p)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=13;fillColor=#faf2d6;strokeColor=#b2963f;fontFamily=Arial;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="420" width="330" height="84" as="geometry" />
        </mxCell>
        <mxCell id="silver" value="Silver ground-truth labels: agreement-based subset of the multi-scorer protocol (66.2% coverage; mean pairwise agreement 0.8122)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=12;fillColor=#ffffff;strokeColor=#a3a3a3;dashed=1;fontFamily=Arial;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="360" y="540" width="330" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== Fusion pipeline ===================== -->
        <mxCell id="pipe-label" value="Knowledge-fusion pipeline" style="text;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;html=1;align=left;fontFamily=Arial;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="760" y="88" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="oof" value="&lt;b&gt;Out-of-fold group-aware scoring&lt;/b&gt;&lt;br&gt;GroupShuffleSplit, 21 groups&lt;br&gt;outer 25% test, inner 20% val, 5 seeds" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=13;fillColor=#dbe7f5;strokeColor=#5f85b8;fontFamily=Arial;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="120" width="290" height="84" as="geometry" />
        </mxCell>
        <mxCell id="calib" value="&lt;b&gt;Isotonic calibration &amp;sigma;_i&lt;/b&gt;&lt;br&gt;fit on training splits" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=13;fillColor=#dfedda;strokeColor=#6e9c5c;fontFamily=Arial;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="220" width="290" height="84" as="geometry" />
        </mxCell>
        <mxCell id="mlp" value="&lt;b&gt;225-parameter fusion MLP&lt;/b&gt;&lt;br&gt;4&#8594;16&#8594;8&#8594;1 ReLU&lt;br&gt;(4x16+16)+(16x8+8)+(8x1+1) = 225" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=13;fillColor=#fdeeda;strokeColor=#c9962f;fontFamily=Arial;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="320" width="290" height="84" as="geometry" />
        </mxCell>
        <mxCell id="tau" value="&lt;b&gt;Operating threshold &amp;tau;&lt;/b&gt;&lt;br&gt;targets 5% FPR on deployment frame" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=8;fontSize=13;fillColor=#dfedda;strokeColor=#6e9c5c;fontFamily=Arial;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="420" width="290" height="84" as="geometry" />
        </mxCell>

        <!-- ===================== Decision ===================== -->
        <mxCell id="dec" value="&lt;b&gt;Risk score &#375;(r)&lt;/b&gt;&lt;br&gt;auditable in-distribution&lt;br&gt;risk scoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7e1f2;strokeColor=#8a74b8;fontSize=14;fontFamily=Arial;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="180" width="300" height="220" as="geometry" />
