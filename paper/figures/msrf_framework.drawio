        </mxCell>

        <!-- ===================== Sources footnote ===================== -->
        <mxCell id="foot" value="Disclosures: intent branch trained in-distribution (training rows overlap the evaluation set by design of the stacking protocol); acoustic branch has no measurable signal at our sample window (N=32 attacks), phrased as &quot;not measured&quot;, not &quot;ineffective&quot;." style="text;strokeColor=none;fillColor=none;fontStyle=2;fontSize=12;html=1;align=left;fontFamily=Arial;fontColor=#555555;" vertex="1" parent="1">
